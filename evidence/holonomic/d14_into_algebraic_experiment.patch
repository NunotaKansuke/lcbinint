+// --- Experimental: D14 radial-event band enumeration --------------------------
+//
+// The algebraic backend's fixed-radius boundary quartic (algebraic_boundary_
+// quartic_fixed) is the same self-inversive quartic P(t;R) the holonomic
+// solver builds; its angular discriminant, with the R^4 chart factor removed,
+// is the degree-14 polynomial D14(v=R^2) whose real positive roots are exactly
+// the radial tangency radii (band birth/death).  holonomic::radial_events
+// enumerates those in __float128 with the same NaN-safe / balanced-Aberth /
+// __float128-fallback policy the holonomic solver uses.
+//
+// This replaces find_radial_bands' seed-anchored exponential march + boolean
+// bisection + Newton tangency search with (#events + 1) radius_has_image probes
+// to classify the inter-event intervals.  Any ambiguity -> fall back to
+// find_radial_bands for the whole epoch and count it; D14 never makes the
+// answer silently wrong.
+BandSearchResult find_radial_bands_d14(
+    const AlgebraicBoundaryLens& lens,
+    SourcePosition source,
+    double source_radius,
+    const std::vector<SourcePosition>& seeds,
+    const AlgebraicBoundarySettings& settings,
+    AlgebraicBoundaryDiagnostics* diagnostics)
+{
+#ifndef ALG_ENABLE_D14
+    return find_radial_bands(lens, source, source_radius, seeds, settings, diagnostics);
+#else
+    auto fallback = [&](const char* /*why*/) {
+        if (diagnostics != nullptr) ++diagnostics->d14_fallback_count;
+        return find_radial_bands(lens, source, source_radius, seeds, settings, diagnostics);
+    };
+
+    // Frame map: algebraic native (origin at the mass-m2 lens) -> holonomic
+    // PrimaryFrame.  Exact; the two fixed-radius quartics are the same poly.
+    namespace hol = lcbinint::holonomic;
+    hol::PrimaryFrame pf;
+    pf.a = lens.lens_position;
+    pf.m0 = lens.m2;
+    pf.X = source.x + lens.lens_position * lens.m1;
+    pf.Y = source.y;
+    pf.rho = source_radius;
+    if (!std::isfinite(pf.a) || !std::isfinite(pf.m0) || !std::isfinite(pf.X) ||
+        !std::isfinite(pf.Y) || !std::isfinite(pf.rho) || !(pf.rho > 0.0) ||
+        !(std::abs(pf.a) > 0.0)) {
+        return fallback("non-finite frame");
+    }
+
+    double r_max = 0.0;
+    std::vector<hol::RadialEvent> events;
+    try {
+        events = hol::radial_events(pf, &r_max);
+    } catch (...) {
+        return fallback("radial_events threw");
+    }
+
+    std::vector<double> edges;
+    for (const auto& e : events) {
+        if (!std::isfinite(e.radius) || e.radius <= 0.0) continue;
+        if (e.physically_real && e.kind == "physical_real") edges.push_back(e.radius);
+    }
+    if (diagnostics != nullptr)
+        diagnostics->d14_event_count = static_cast<int>(edges.size());
+    std::sort(edges.begin(), edges.end());
+    edges.erase(std::unique(edges.begin(), edges.end(),
+        [](double x, double y) { return std::abs(x - y) <= 1.0e-11 * (1.0 + std::abs(y)); }),
+        edges.end());
+    if (edges.empty()) return fallback("D14 returned no physical_real events");
+
+    // Interval partition points: 0, edges..., and an outer sentinel past the
+    // largest edge / seed radius.
+    double outer = edges.back();
+    for (const auto& seed : seeds) outer = std::max(outer, std::hypot(seed.x, seed.y));
+    std::vector<double> pts;
+    pts.push_back(0.0);
+    for (double e : edges) pts.push_back(e);
+    pts.push_back(outer + std::max(source_radius, 1.0e-9));
+
+    std::vector<std::pair<double, double>> bands;
+    for (std::size_t i = 0; i + 1 < pts.size(); ++i) {
+        const double mid = 0.5 * (pts[i] + pts[i + 1]);
+        std::string reason;
+        const bool inside = radius_has_image(
+            lens, source, source_radius, mid, settings, diagnostics, &reason);
+        if (!reason.empty()) return fallback("radius_has_image inconclusive");
+        if (inside) bands.emplace_back(pts[i], pts[i + 1]);
+    }
+
+    std::sort(bands.begin(), bands.end());
+    std::vector<std::pair<double, double>> merged;
+    for (const auto& band : bands) {
+        const double tol = 1.0e-11 * (1.0 + std::abs(band.second));
+        if (merged.empty() || band.first > merged.back().second + tol) {
+            merged.push_back(band);
+        } else {
+            merged.back().second = std::max(merged.back().second, band.second);
+        }
+    }
+    if (merged.empty()) return fallback("D14 classified every interval as outside");
+
+    // Every certified seed radius must sit inside a band, else D14 missed an
+    // event -> fall back rather than integrate an incomplete support set.
+    for (const auto& seed : seeds) {
+        const double sr = std::hypot(seed.x, seed.y);
+        const bool covered = std::any_of(merged.begin(), merged.end(),
+            [&](const auto& b) { return sr >= b.first - 1e-12 && sr <= b.second + 1e-12; });
+        if (!covered) return fallback("D14 band set does not cover a certified seed");
+    }
+
+    if (diagnostics != nullptr) {
+        ++diagnostics->d14_band_enum_count;
+        diagnostics->radial_band_count = static_cast<int>(merged.size());
+    }
+    return {true, std::move(merged), {}};
+#endif
+}
+
+static bool alg_d14_enabled() {
+#ifdef ALG_ENABLE_D14
+    // Read fresh so an in-process A/B harness can toggle via setenv().
+    const char* f = std::getenv("ALG_D14");
+    return f != nullptr && *f != '\0' && *f != '0';
+#else
+    return false;
+#endif
+}
+
+BandSearchResult find_radial_bands_dispatch(
+    const AlgebraicBoundaryLens& lens,
+    SourcePosition source,
+    double source_radius,
+    const std::vector<SourcePosition>& seeds,
+    const AlgebraicBoundarySettings& settings,
+    AlgebraicBoundaryDiagnostics* diagnostics)
+{
+    if (alg_d14_enabled())
+        return find_radial_bands_d14(lens, source, source_radius, seeds, settings, diagnostics);
+    return find_radial_bands(lens, source, source_radius, seeds, settings, diagnostics);
+}
