+#ifdef HOLO_D14_FIRST_MIXED_SWEEP
+inline void d14_first_mixed_eval(const D14StructC<double>& s,
+ const Cplx<D14Real>& arg,Cplx<D14Real>& D,Cplx<D14Real>& Dp){
+ Cplx<double> vd(double(arg.re),double(arg.im)),cd,cpd,gd,gpd,zd,zpd;
+ horner_vd(s.c3,3,vd,cd,cpd);horner_vd(s.g4,4,vd,gd,gpd);horner_vd(s.z3,3,vd,zd,zpd);
+ auto lift=[](Cplx<double> x){return Cplx<D14Real>(D14Real(x.re),D14Real(x.im));};
+ auto c=lift(cd),cp=lift(cpd),g=lift(gd),gp=lift(gpd),z=lift(zd),zp=lift(zpd),v=lift(vd);
+    const Cplx<D14Real> two(D14Real(2), D14Real(0)), four(D14Real(4), D14Real(0)), nine(D14Real(9), D14Real(0));
+    Cplx<D14Real> cc = c * c;
+    Cplx<D14Real> vg = v * g;
+    Cplx<D14Real> f = cc - four * vg;
+    Cplx<D14Real> b = two * cc - nine * vg;
+    Cplx<D14Real> gg = g * g;
+    Cplx<D14Real> zz = z * z;
+    Cplx<D14Real> vv = v * v;
+
+    Cplx<D14Real> Dhat = f * gg + Cplx<D14Real>(D14Real(8), D14Real(0)) * (c * b * z)
+                 - Cplx<D14Real>(D14Real(432), D14Real(0)) * (vv * zz);
+
+    Cplx<D14Real> ccp = c * cp;
+    Cplx<D14Real> fp = two * ccp - four * g - four * (v * gp);
+    Cplx<D14Real> bp = four * ccp - nine * g - nine * (v * gp);
+    Cplx<D14Real> Dhatp = fp * gg + two * (f * (g * gp))
+                  + Cplx<D14Real>(D14Real(8), D14Real(0)) * ((cp * b + c * bp) * z + c * b * zp)
+                  - Cplx<D14Real>(D14Real(864), D14Real(0)) * (v * zz)
+                  - Cplx<D14Real>(D14Real(864), D14Real(0)) * (vv * (z * zp));
+
+    const Cplx<D14Real> k(D14Real(4096), D14Real(0));
+    D = k * Dhat;
+    Dp = k * Dhatp;
+}
+#endif
