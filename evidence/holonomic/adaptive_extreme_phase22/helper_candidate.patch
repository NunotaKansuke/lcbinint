+__attribute__((noinline)) inline bool d14_batch_inverse(
+    const Cplx<double>* roots,int i,Cplx<double>* diffs,double* norms,double* inv) {
+    unsigned bad=0;
+    for(int j=0;j<14;++j){
+        const auto d=roots[i]-roots[j];diffs[j]=d;
+        const double n=j==i?1.0:d.re*d.re+d.im*d.im;
