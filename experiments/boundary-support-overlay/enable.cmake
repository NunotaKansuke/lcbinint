# Explicit experiment overlay; ordinary builds compile the master kernels.
set(_boundary_overlay "${CMAKE_CURRENT_LIST_DIR}")
foreach(_target lcbinint_magnification lcbinint_lightcurve lcbinint_python test_core)
    if(TARGET ${_target})
        get_target_property(_sources ${_target} SOURCES)
        set(_overlaid_sources)
        foreach(_source IN LISTS _sources)
            if(EXISTS "${_boundary_overlay}/${_source}")
                list(APPEND _overlaid_sources "${_boundary_overlay}/${_source}")
            else()
                list(APPEND _overlaid_sources "${_source}")
            endif()
        endforeach()
        set_property(TARGET ${_target} PROPERTY SOURCES "${_overlaid_sources}")
        target_include_directories(${_target} BEFORE PUBLIC "${_boundary_overlay}/src")
    endif()
endforeach()
target_sources(lcbinint_magnification PRIVATE
    "${CMAKE_CURRENT_SOURCE_DIR}/src/lcbinint/magnification/binary_image_discriminant.cpp")
if(TARGET lcbinint_python)
    target_include_directories(lcbinint_python PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/python")
endif()
if(LCBININT_BUILD_TESTS)
    add_executable(test_boundary_support "${CMAKE_CURRENT_SOURCE_DIR}/tests/unit/test_boundary_support.cpp")
    target_include_directories(test_boundary_support BEFORE PRIVATE "${_boundary_overlay}/src" "${LCBININT_BOOST_INCLUDE_DIR}")
    target_link_libraries(test_boundary_support PRIVATE lcbinint_lightcurve lcbinint_magnification lcbinint_lightcurve)
    add_test(NAME unit_boundary_support COMMAND test_boundary_support)
endif()
